GROQ_API_KEY=your_groq_api_key_here

# MySQL (Railway provides these automatically on deployment)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aura_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
