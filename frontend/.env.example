# ── Environment Variable Reference ───────────────────────────────────────────
# Copy this file to .env.local for local overrides, or configure these
# variables in your Vercel project settings for production deployments.
#
# ⚠  NEVER commit .env.local or .env.production to Git — they are in .gitignore.

# WebSocket URL for the Aura voice agent backend.
#   Production value:  wss://aura-ai-chat-bot.onrender.com/ws/voice
#   Local dev value:   ws://localhost:8080/ws/voice
#   (local dev also works without setting this variable at all, via Vite proxy)
VITE_WS_URL=wss://aura-ai-chat-bot.onrender.com/ws/voice

